__pycache__/
*.pyc
nohup.out
.venv/
# Local agent configuration and credentials.
.env
.env.*
!.env.example
.claude/
.codex/
attempts/.run.lock

# AutoTao's imported and last-known runtime state is machine-local. The portable
# project contract is autotao.json; state snapshots must never enter git.
.autotao/
/autotao.json.tmp-*

# Raw agent logs: large, and they contain whatever the run happened to print.
# Keep them locally (the triage tier reads them); never publish them.
attempts/raw-logs/*
!attempts/raw-logs/.gitkeep

# Supervision scratch state.
attempts/supervision/*
!attempts/supervision/.gitkeep

# Paper cache: binaries and extracted text stay local (size + copyright).
# Metadata (papers/INDEX.tsv, papers/WANTED.md) is tracked so the record of what
# was fetched — and what is still missing — survives in git.
papers/*.pdf
papers/*.pdf.part
papers/*.txt
papers/*.notpdf
papers/.*.err

# Bulk search output from attempts. Preserved on disk per the never-delete rule,
# but must never enter git history — one crashed run wrote 397MB of these.
attempts/**/*.out
attempts/**/s_all_*.txt

# One-off local release reviews and handoff notes are operator scratch, not
# product documentation. Durable release notes belong in CHANGELOG.md.
release-audit/
CLAUDE_RELEASE_AUDIT_HANDOFF.md
