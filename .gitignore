__pycache__/
*.pyc
nohup.out
.venv/
.claude/settings.local.json
attempts/.run.lock

# AutoTao's imported and last-known runtime state is machine-local. State snapshots
# must never enter git.
.autotao/

# The operator's live config. Tracked as autotao.example.json instead: this file is
# not a static contract, it is runtime state the app rewrites. Pressing `u` in the
# TUI writes the usage policy straight back here (RepositoryController.updateUsagePolicy,
# via the .tmp- rename below), so tracking it meant every operator keystroke dirtied
# the working tree — and one such write, reservePercent 5 -> 10, was committed as
# 933b205 "Leave a ten percent usage reserve" before this split existed. It also
# carries per-machine choices (engine, model, effort, autoLaunch) that no clone should
# inherit; a fresh checkout should not arrive with autopilot already switched on.
/autotao.json

# Raw agent logs: large, and they contain whatever the run happened to print.
# Keep them locally (the triage tier reads them); never publish them.
attempts/raw-logs/*.log
attempts/raw-logs/*.jsonl

# Supervision scratch state.
attempts/supervision/*
!attempts/supervision/.gitkeep

# Paper cache: binaries and extracted text stay local (size + copyright).
# Metadata (papers/INDEX.tsv, papers/WANTED.md) is tracked so the record of what
# was fetched — and what is still missing — survives in git.
papers/*.pdf
papers/*.txt
papers/*.notpdf
papers/.*.err

# Bulk search output from attempts. Preserved on disk per the never-delete rule,
# but must never enter git history — one crashed run wrote 397MB of these.
attempts/**/*.out
attempts/**/s_all_*.txt
