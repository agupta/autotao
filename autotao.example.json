{
  "$schema": "./apps/autotao/autotao.schema.json",
  "schemaVersion": 1,
  "engine": "claude",
  "model": "claude-fable-5",
  "effort": "xhigh",
  "project": {
    "name": "autotao",
    "adapter": "autotao"
  },
  "refreshMs": 5000,
  "automation": {
    "autoLaunch": false,
    "launchIntervalMs": 600000,
    "tickIntervalMs": 900000
  },
  "usage": {
    "reservePercent": 10,
    "pace": "even"
  },
  "commands": {
    "launch": ["bash", "scripts/launch.sh"],
    "tick": ["bash", "scripts/supervisor-tick.sh"]
  }
}
