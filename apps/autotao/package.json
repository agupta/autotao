{
  "name": "autotao",
  "version": "0.1.0",
  "description": "Use spare AI subscription allowance for paced, autonomous mathematics runs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agupta/autotao.git"
  },
  "homepage": "https://github.com/agupta/autotao#readme",
  "keywords": ["tui", "agents", "mathematics", "claude", "codex", "opentui"],
  "files": [
    "src",
    "scripts",
    "autotao.schema.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "autotao": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun --preload @opentui/solid/preload src/index.tsx",
    "snapshot": "bun src/index.tsx snapshot --json",
    "doctor": "bun src/index.tsx doctor",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test",
    "build": "bun scripts/build.ts",
    "demo": "bun --conditions=browser scripts/demo.tsx",
    "verify": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "@opentui/solid": "0.5.1",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14"
}
